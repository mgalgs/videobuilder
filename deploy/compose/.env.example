# Copy to .env (cp .env.example .env), fill in, then: docker compose up -d
# README.md explains each step.

# The admin account's username. Its password is the one line in the file
# ./admin-password (see README.md); the stack refuses to start without both.
VB_ADMIN=admin

# The hostname people use to reach the editor through your TLS reverse proxy.
# Leave empty to allow only http://127.0.0.1 (e.g. over an ssh tunnel).
VB_PUBLIC_HOST=editor.example.com

# The builder's credential: run `claude setup-token` on any machine with
# Claude Code, and paste the token it prints. Keep this file private.
CLAUDE_CODE_OAUTH_TOKEN=

# The model the builder runs on.
VB_MODEL=claude-opus-5-5

# The loopback port the editor is published on (127.0.0.1 only).
VB_PORT=8100
